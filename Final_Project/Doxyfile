# Lägg allt i en väldigt kort mapp
OUTPUT_DIRECTORY    = d
HTML_OUTPUT         = h
LATEX_OUTPUT        = l

# Gör filnamnen korta (annars blir de lååånga av templatenamn)
SHORT_NAMES         = YES

# Dela upp i undermappar (lite snällare mot filsystemet)
CREATE_SUBDIRS      = YES

# Begränsa vilka filer som dokumenteras (ta inte med externa headers)
INPUT               = .
RECURSIVE           = YES
EXCLUDE           = build \
                    cmake-build-* \
                    .git \
                    docs \
                    vcpkg_installed \
                    external \
                    third_party
EXCLUDE_PATTERNS  = */fmt/* \
                    */nlohmann/* \
                    */vcpkg/* \
                    */external/* \
                    */third_party/*


# (valfritt) Dölj symboler från externa lib om de ändå slinker igenom:
EXCLUDE_SYMBOLS     = fmt::* nlohmann::*


# ========== Grundinfo ==========
PROJECT_NAME           = "Weather Planner"
PROJECT_BRIEF          = "CLI-app som hämtar väderdata och genererar rekommendationer"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OPTIMIZE_OUTPUT_FOR_CPLUSPLUS = YES
EXTRACT_ALL            = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

# ========== Indata ==========
# Sätt till . för att inkludera allt under projektroten.
INPUT                  = .
RECURSIVE              = YES

# Begränsa till vanliga C++-filer
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.hh \
                         *.cpp \
                         *.cc \
                         *.ipp

# Uteslut bygg- & doc-mappar m.m. (lägg till fler vid behov)
EXCLUDE                = build \
                         cmake-build-* \
                         .git \
                         docs/html \
                         docs/latex

# Gör att sökvägar blir snyggare i källkodslistning
STRIP_FROM_PATH        = .

# ========== Vad som extraheras ==========
EXTRACT_PRIVATE        = YES
EXTRACT_PROTECTED      = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = NO

# ========== HTML ==========
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
VERBATIM_HEADERS       = YES

# ========== Diagram (Graphviz/DOT) ==========
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_DIAGRAMS         = YES
DOT_TRANSPARENT        = YES
DOT_GRAPH_MAX_NODES    = 50
# Om dot inte hittas via PATH, avkommentera och peka ut:
# DOT_PATH            = "C:/Program Files/Graphviz/bin"

# ========== LaTeX / PDF ==========
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
PDF_HYPERLINKS         = YES
LATEX_BATCHMODE        = YES
# Snyggare typsnitt (valfritt, funkar om paket finns)
# LATEX_EXTRA_STYLESHEET =

# ========== Övrigt ==========
ALPHABETICAL_INDEX     = YES
FULL_PATH_NAMES        = NO

# Diagram (Graphviz/DOT)
HAVE_DOT              = NO
CLASS_DIAGRAMS        = NO
CALL_GRAPH            = NO
CALLER_GRAPH          = NO
COLLABORATION_GRAPH   = NO
GROUP_GRAPHS          = NO
INCLUDE_GRAPH         = NO
INCLUDED_BY_GRAPH     = NO
DIRECTORY_GRAPH       = NO
GRAPHICAL_HIERARCHY   = NO

